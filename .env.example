# ====== LLM 配置 ======
# 推荐用 DeepSeek（便宜、function calling 支持好），也兼容任意 OpenAI 格式接口
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=deepseek-chat

# ====== Embedding 配置 ======
# local = 本地跑 BGE（数据不出域，首次会自动下载模型，需要联网）
# openai = 调用兼容 OpenAI 的 embedding 接口（如通义/智谱/OpenAI）
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 仅当 EMBEDDING_PROVIDER=openai 时需要：
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ====== Rerank 重排序 ======
USE_RERANK=true
RERANK_MODEL=BAAI/bge-reranker-base

# ====== RAG 参数 ======
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=8
RERANK_TOP_K=4

# ====== Agent 参数 ======
MAX_STEPS=6
SANDBOX_TIMEOUT=15
